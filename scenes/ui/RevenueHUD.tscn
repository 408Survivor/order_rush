[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/revenue_hud.gd" id="1_hud"]

; ===== 经营面板 HUD（issue #26 / #48 tscn 化） =====
; 节点路径 RevenueHUD/Panel/Margin/VBox/{DayTimeLabel,TimeLabel,TimeBar,RevenueLabel,GoodLabel,BadLabel}
; 为冒烟测试硬依赖，改名/移动需同步 addons/smoke_test/smoke_plugin.gd

[node name="RevenueHUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Panel" type="PanelContainer" parent="."]
anchor_left = 1.0
anchor_right = 1.0
offset_left = -300.0
offset_top = 12.0
offset_right = -16.0
offset_bottom = 148.0
grow_horizontal = 0

[node name="Margin" type="MarginContainer" parent="Panel"]
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 8

[node name="VBox" type="VBoxContainer" parent="Panel/Margin"]
theme_override_constants/separation = 4

[node name="DayTimeLabel" type="RichTextLabel" parent="Panel/Margin/VBox"]
bbcode_enabled = true
fit_content = true
alignment = 1
mouse_filter = 2
theme_override_colors/default_color = Color(0.85, 0.65, 0.18, 1)
theme_override_colors/outline_color = Color(0, 0, 0, 0.8)
theme_override_constants/outline_size = 6
theme_override_font_sizes/normal_font_size = 24
text = "[img width=22 height=22]res://assets/art/ui/icons/calendar.svg[/img] 第 1 天"

[node name="TimeLabel" type="RichTextLabel" parent="Panel/Margin/VBox"]
bbcode_enabled = true
fit_content = true
alignment = 1
mouse_filter = 2
theme_override_colors/default_color = Color(0.85, 0.65, 0.18, 1)
theme_override_colors/outline_color = Color(0, 0, 0, 0.8)
theme_override_constants/outline_size = 5
theme_override_font_sizes/normal_font_size = 20
text = "[img width=20 height=20]res://assets/art/ui/icons/timer.svg[/img] 营业剩余 90s"

[node name="TimeBar" type="ProgressBar" parent="Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 14)
mouse_filter = 2
max_value = 100.0
value = 100.0
show_percentage = false

[node name="RevenueLabel" type="RichTextLabel" parent="Panel/Margin/VBox"]
bbcode_enabled = true
fit_content = true
alignment = 1
mouse_filter = 2
theme_override_colors/default_color = Color(0.85, 0.65, 0.18, 1)
theme_override_colors/outline_color = Color(0, 0, 0, 0.8)
theme_override_constants/outline_size = 6
theme_override_font_sizes/normal_font_size = 34
text = "营业额：0"

[node name="GoodLabel" type="RichTextLabel" parent="Panel/Margin/VBox"]
bbcode_enabled = true
fit_content = true
alignment = 1
mouse_filter = 2
theme_override_colors/default_color = Color(0.18, 0.62, 0.36, 1)
theme_override_colors/outline_color = Color(0, 0, 0, 0.8)
theme_override_constants/outline_size = 5
theme_override_font_sizes/normal_font_size = 20
text = "好评：0"

[node name="BadLabel" type="RichTextLabel" parent="Panel/Margin/VBox"]
bbcode_enabled = true
fit_content = true
alignment = 1
mouse_filter = 2
theme_override_colors/default_color = Color(0.88, 0.29, 0.23, 1)
theme_override_colors/outline_color = Color(0, 0, 0, 0.8)
theme_override_constants/outline_size = 5
theme_override_font_sizes/normal_font_size = 20
text = "差评：0"

[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/character_select.gd" id="1_select"]

; ===== 角色选择界面（P8 / #48 tscn 化） =====
; Overlay process_mode=ALWAYS（选择前暂停游戏）；角色卡由脚本 refresh() 动态重建到 List 下

[node name="CharacterSelect" type="CanvasLayer"]
script = ExtResource("1_select")

[node name="Overlay" type="ColorRect" parent="."]
process_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0, 0, 0, 0.5)
visible = false

[node name="CenterContainer" type="CenterContainer" parent="Overlay"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Overlay/CenterContainer"]
custom_minimum_size = Vector2(520, 0)

[node name="Margin" type="MarginContainer" parent="Overlay/CenterContainer/Panel"]
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 24

[node name="VBox" type="VBoxContainer" parent="Overlay/CenterContainer/Panel/Margin"]
theme_override_constants/separation = 12

[node name="RuleTop" type="ColorRect" parent="Overlay/CenterContainer/Panel/Margin/VBox"]
custom_minimum_size = Vector2(140, 2)
size_flags_horizontal = 4
color = Color(0.721569, 0.52549, 0.0431373, 0.8)

[node name="Title" type="Label" parent="Overlay/CenterContainer/Panel/Margin/VBox"]
theme_override_colors/font_color = Color(0.85098, 0.65098, 0.180392, 1)
theme_override_colors/font_outline_color = Color(0.29, 0.22, 0.16, 0.85)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 30
text = "选择你的主厨"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Overlay/CenterContainer/Panel/Margin/VBox"]
theme_override_colors/font_color = Color(0.29, 0.22, 0.16, 0.55)
theme_override_colors/font_outline_color = Color(0.29, 0.22, 0.16, 0.85)
theme_override_constants/outline_size = 4
theme_override_font_sizes/font_size = 16
text = "不同主厨拥有不同技能，开店后生效"
horizontal_alignment = 1

[node name="RuleBottom" type="ColorRect" parent="Overlay/CenterContainer/Panel/Margin/VBox"]
custom_minimum_size = Vector2(140, 2)
size_flags_horizontal = 4
color = Color(0.721569, 0.52549, 0.0431373, 0.8)

[node name="List" type="HBoxContainer" parent="Overlay/CenterContainer/Panel/Margin/VBox"]
alignment = 1
theme_override_constants/separation = 14

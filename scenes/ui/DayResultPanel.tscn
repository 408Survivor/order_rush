; ===== 日结算面板（P3 / #48 tscn 化） =====
; Overlay 及子树 process_mode=ALWAYS——打烊暂停后弹出动画仍推进（tween 归属脚本节点）
; 主按钮「进入下一天」的三态纹理样式由脚本 _ready 设置（UITheme.make_button_texture_styles）

[node name="DayResultPanel" type="CanvasLayer"]
script = ExtResource("1_panel")

[node name="Overlay" type="ColorRect" parent="."]
process_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0, 0, 0, 0.55)
visible = false

[node name="CenterContainer" type="CenterContainer" parent="Overlay"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Overlay/CenterContainer"]

[node name="Margin" type="MarginContainer" parent="Overlay/CenterContainer/Panel"]
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 28
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 28

[node name="VBox" type="VBoxContainer" parent="Overlay/CenterContainer/Panel/Margin"]

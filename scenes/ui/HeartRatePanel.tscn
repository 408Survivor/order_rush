[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/heart_rate_panel.gd" id="1_hr"]
[ext_resource type="Texture2D" path="res://assets/art/ui/icons/heart.svg" id="2_heart"]

; ===== 心率面板（#82 全局营业压力） =====
; 左下角常驻小面板（Toast 容器上方 -140 起，本面板收在 -148 以上，与临时提示错开）；
; 节点路径 HeartRatePanel/Panel/Margin/HBox/{Icon,Bar,Value} 为冒烟测试硬依赖

[node name="HeartRatePanel" type="CanvasLayer"]
script = ExtResource("1_hr")

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = -200.0
offset_right = 320.0
offset_bottom = -148.0
grow_vertical = 0
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="Panel"]
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 6
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 6

[node name="HBox" type="HBoxContainer" parent="Panel/Margin"]
theme_override_constants/separation = 8
alignment = 1

[node name="Icon" type="TextureRect" parent="Panel/Margin/HBox"]
custom_minimum_size = Vector2(28, 28)
mouse_filter = 2
texture = ExtResource("2_heart")
expand_mode = 1
stretch_mode = 5

[node name="Bar" type="ProgressBar" parent="Panel/Margin/HBox"]
custom_minimum_size = Vector2(170, 18)
size_flags_vertical = 4
mouse_filter = 2
max_value = 100.0
value = 20.0
show_percentage = false

[node name="Value" type="Label" parent="Panel/Margin/HBox"]
mouse_filter = 2
theme_override_colors/font_color = Color(0.180392, 0.619608, 0.356863, 1)
theme_override_font_sizes/font_size = 20
text = "20"
